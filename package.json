{
  "name": "mb-haaste-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch ./src/index.ts",
    "db:generate": "drizzle-kit generate --custom --name",
    "db:drop": "docker exec -it mb-haaste-backend-app-1 npx drizzle-kit drop",
    "db:migrate": "docker exec -it mb-haaste-backend-app-1 npx drizzle-kit migrate",
    "db:open": "docker exec -it mb-haaste-backend-db-1 psql -U postgres app"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  }
}
